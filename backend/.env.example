DATABASE_URL=postgres://notebook:notebook@localhost:5433/notebook
PORT=3333
# Endereço em que a API escuta. 127.0.0.1 = só este computador (a API não tem login).
HOST=127.0.0.1
# Pedidos por minuto às rotas que chamam o Gemini (protege a cota gratuita)
AI_RATE_LIMIT_PER_MINUTE=20
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50
# Tamanho e sobreposição dos chunks, em caracteres
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Embeddings: "gemini" (padrão) ou "fake" (vetores locais, só para testar sem chave)
EMBEDDING_PROVIDER=gemini
# Crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Modelo das respostas e quanto ele "pensa" antes (MINIMAL | LOW | MEDIUM | HIGH)
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=LOW

# Banco usado por "npm run test:integration" (é apagado a cada execução)
TEST_DATABASE_URL=postgres://notebook:notebook@localhost:5433/notebook_test

# Avaliação (npm run eval): banco próprio, ZERADO a cada execução
EVAL_DATABASE_URL=postgres://notebook:notebook@localhost:5433/notebook_eval
# Modelo que julga correção e fidelidade das respostas
GEMINI_JUDGE_MODEL=gemini-3.8-flash
